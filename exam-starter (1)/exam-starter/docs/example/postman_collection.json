{
  "info": {
    "name": "Books & Catalogs API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "baseUrl", "value": "http://localhost:3000" }],
  "item": [
    {
      "name": "Catalogs",
      "item": [
        {
          "name": "List catalogs",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/catalogs?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "catalogs"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "List all catalogs (dropdown)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/catalogs?all=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "catalogs"],
              "query": [{ "key": "all", "value": "true" }]
            }
          }
        },
        {
          "name": "Get catalog",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/catalogs/1", "host": ["{{baseUrl}}"], "path": ["api", "catalogs", "1"] }
          }
        },
        {
          "name": "Create catalog",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"หมวดใหม่\",\n  \"description\": \"ตัวอย่าง\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/catalogs", "host": ["{{baseUrl}}"], "path": ["api", "catalogs"] }
          }
        },
        {
          "name": "Update catalog",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"หมวดที่แก้ไข\",\n  \"description\": \"แก้ไขแล้ว\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/catalogs/1", "host": ["{{baseUrl}}"], "path": ["api", "catalogs", "1"] }
          }
        },
        {
          "name": "Delete catalog",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/catalogs/1", "host": ["{{baseUrl}}"], "path": ["api", "catalogs", "1"] }
          }
        }
      ]
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "List books",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/books?q=&catalog_id=&page=1&limit=10&sort=id&order=desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"],
              "query": [
                { "key": "q", "value": "" },
                { "key": "catalog_id", "value": "" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "sort", "value": "id" },
                { "key": "order", "value": "desc" }
              ]
            }
          }
        },
        {
          "name": "Get book",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/books/1", "host": ["{{baseUrl}}"], "path": ["api", "books", "1"] }
          }
        },
        {
          "name": "Create book (with cover)",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "title", "value": "หนังสือใหม่", "type": "text" },
                { "key": "author", "value": "ผู้แต่ง", "type": "text" },
                { "key": "isbn", "value": "9786168209999", "type": "text" },
                { "key": "price", "value": "250", "type": "text" },
                { "key": "publish_year", "value": "2024", "type": "text" },
                { "key": "catalog_id", "value": "1", "type": "text" },
                { "key": "cover", "type": "file", "src": [] }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/books", "host": ["{{baseUrl}}"], "path": ["api", "books"] }
          }
        },
        {
          "name": "Update book (cover optional)",
          "request": {
            "method": "PUT",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "title", "value": "ชื่อที่แก้ไข", "type": "text" },
                { "key": "author", "value": "ผู้แต่ง", "type": "text" },
                { "key": "isbn", "value": "", "type": "text" },
                { "key": "price", "value": "300", "type": "text" },
                { "key": "publish_year", "value": "2024", "type": "text" },
                { "key": "catalog_id", "value": "1", "type": "text" },
                { "key": "cover", "type": "file", "src": [] }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/books/1", "host": ["{{baseUrl}}"], "path": ["api", "books", "1"] }
          }
        },
        {
          "name": "Delete book",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/books/1", "host": ["{{baseUrl}}"], "path": ["api", "books", "1"] }
          }
        }
      ]
    }
  ]
}
